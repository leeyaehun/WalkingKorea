{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "walkingkorea",
  "main": "./src/server/worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PUBLIC_WALK_ROOMS",
        "class_name": "PublicWalkRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "multiplayer-v1",
      "new_sqlite_classes": [
        "PublicWalkRoom"
      ]
    }
  ]
}
